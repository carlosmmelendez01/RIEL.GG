# ArcLight — environment variables
# Copy this file to `.env.local` and fill in the values from Supabase + Vercel.

# --- Supabase (client) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Database (Prisma) -----------------------------------------------------
# Production points these at Supabase: pooled connection (port 6543) for
# runtime, direct (5432) for migrations.
#
# For LOCAL DEVELOPMENT, point them at a local Postgres instead, so migrations
# and seeds never touch the deployed database:
#   brew install postgresql@17 && brew services start postgresql@17
#   createdb riel_dev
#   DATABASE_URL=postgresql://$USER@localhost:5432/riel_dev
#   DIRECT_URL=postgresql://$USER@localhost:5432/riel_dev
#
# CI uses its own throwaway Postgres service container - see
# .github/workflows/ci.yml. Tests never run against a shared database.
DATABASE_URL=
DIRECT_URL=
# Local demo tooling only. Do not set this in the production app runtime.
SUPABASE_SERVICE_ROLE_KEY=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (Resend) --------------------------------------------------------
# Get RESEND_API_KEY at https://resend.com/api-keys. Without it, the app falls
# back to console-logging emails — every flow keeps working in dev without
# anything wired up.
# RESEND_FROM_ADDRESS must use a domain you've verified in Resend (or the
# `onboarding@resend.dev` sandbox, which only delivers to your account email).
RESEND_API_KEY=
RESEND_FROM_ADDRESS=ArcLight <hello@riel.gg>

# --- Beta / demo -----------------------------------------------------------
# Local development only. Production refuses /dev sign-in even if these flags
# are accidentally enabled. Only the listed accounts can be impersonated.
ENABLE_DEMO_AUTH=false
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false
DEMO_AUTH_EMAILS=
DEMO_AUTH_PASSWORD=

# Shared beta access password. When set, the entire site is locked behind a
# /beta-gate page until a visitor enters this. Leave blank to disable the gate.
BETA_ACCESS_PASSWORD=

# Where in-app "Send feedback" submissions are emailed. Requires RESEND_API_KEY
# to actually deliver; otherwise feedback is only stored in the DB.
FEEDBACK_EMAIL=

# --- Platform (SaaS admin) -------------------------------------------------
# The /platform/* pages are still rendered from lib/mock/* — fabricated schools,
# audit rows and support tickets. They are OFF unless this is explicitly "true",
# in which case the route group 404s for everyone. Turning it on also re-enables
# the platform-only "provision a league" action.
ENABLE_PLATFORM_ADMIN=false

# Comma-separated emails allowed into /platform/* once the flag above is on.
PLATFORM_ADMIN_EMAILS=
